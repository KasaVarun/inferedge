  "definitions": {
    "within_run": "Each report's mean, p50, p95, and p99 describe the measured calls pooled inside that one concurrent process. P99 is that process's nearest-rank order statistic.",
    "median_of_run_p99": "median_of_run_p99_microseconds is the median of the five per-process P99 values. It is not a pooled percentile of the combined samples. Schema version 2 does not contain raw samples, so a pooled P99 is not computed.",
    "relative_run_mean_range": "(maximum run mean - minimum run mean) / median of the run means",
    "relative_aggregate_throughput_range": "(maximum aggregate throughput - minimum aggregate throughput) / median aggregate throughput",
    "throughput_ratio": "throughput_ratio(N) is the median aggregate completed requests per second at worker count N divided by the same median at worker count 1 for that workload. Active-call throughput is recorded separately and is not the scaling numerator. Sequential active-call throughput is not a speedup baseline.",
    "scaling_efficiency": "scaling_efficiency(N) is throughput_ratio(N) divided by N. Linear scaling is not assumed.",
    "latency_ratios": "latency_mean_ratio(N) and latency_p99_ratio(N) divide the worker-count-N median of run means, or the median of per-process P99 values, by the worker-count-1 value for the same workload.",
    "confidence_interval": "Five counted runs do not establish statistical significance. No confidence interval is computed.",
    "pilots": "Pilot trials are validated with the same evidence checks and then excluded from latency reductions, throughput reductions, scaling ratios, scaling efficiency, and run-to-run variation."
  },
